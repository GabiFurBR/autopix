import:
    io.github.warleysr.autopix.api.AutoPixAPI
    io.github.warleysr.autopix.events.PaymentApprovedEvent
    io.github.warleysr.autopix.events.DeliveryStartedEvent
    io.github.warleysr.autopix.events.DeliveryCompletedEvent
    io.github.warleysr.autopix.events.DeliveryFailedEvent
    io.github.warleysr.autopix.events.DeliveryNeedsReviewEvent
    org.bukkit.entity.Player
    org.bukkit.Bukkit
function executarEntregaCustomLoja(p: player, handler: text, orderId: text, itemIndex: number, claimToken: text, orderItem: object) :: boolean:
    if {_p} is not set:
        return false
    if {_p}.isOnline() is not true:
        return false
    if {_handler} is not set:
        return false
    if {_orderItem} is not set:
        return false
    if {_claimToken} is not set:
        return false
    if {_claimToken} is "":
        return false
    set {_productId} to {_orderItem}.getProductId()
    set {_quantity} to {_orderItem}.getQuantity()
    if {_quantity} is not set:
        return false
    if {_quantity} <= 0:
        return false
    set {_unitAmount} to 0
    if {_handler} is "gems_purchase":
        if {_productId} is "gems_5k":
            set {_unitAmount} to 5000
        else if {_productId} is "gems_25k":
            set {_unitAmount} to 25000
        else if {_productId} is "gems_100k":
            set {_unitAmount} to 100000
        else:
            return false
    else if {_handler} is "stars_purchase":
        if {_productId} is "stars_100":
            set {_unitAmount} to 100
        else if {_productId} is "stars_500":
            set {_unitAmount} to 500
        else:
            return false
    else if {_handler} is "event_coins_purchase":
        if {_productId} is "event_coins_500":
            set {_unitAmount} to 500
        else if {_productId} is "event_coins_2500":
            set {_unitAmount} to 2500
        else:
            return false
    else:
        return false
    if {_unitAmount} <= 0:
        return false
    set {_amount} to {_unitAmount} * {_quantity}
    set {_deliveryState} to {autopix::delivery::%{_orderId}%::%{_itemIndex}%::state}
    if {_deliveryState} is "APPLIED":
        return true
    if {_deliveryState} is set:
        return false
    set {autopix::delivery::%{_orderId}%::%{_itemIndex}%::state} to "PROCESSING"
    set {autopix::delivery::%{_orderId}%::%{_itemIndex}%::claim} to {_claimToken}
    set {autopix::delivery::%{_orderId}%::%{_itemIndex}%::handler} to {_handler}
    set {autopix::delivery::%{_orderId}%::%{_itemIndex}%::amount} to {_amount}
    if {_handler} is "gems_purchase":
        addgem({_p}, {_amount})
        nr_reward_record({_p}, "Loja AutoPix", "%{_amount}% Gemas")
        lojaSucesso({_p}, "Compra confirmada: &b%{_amount}% Gemas&f adicionadas à sua conta.")
    else if {_handler} is "stars_purchase":
        addstars({_p}, {_amount})
        nr_reward_record({_p}, "Loja AutoPix", "%{_amount}% Estrelas")
        lojaSucesso({_p}, "Compra confirmada: &e%{_amount}% Estrelas&f adicionadas à sua conta.")
    else if {_handler} is "event_coins_purchase":
        addpumpcoins({_p}, {_amount})
        nr_reward_record({_p}, "Loja AutoPix", "%{_amount}% PumpCoins")
        lojaSucesso({_p}, "Compra confirmada: &6%{_amount}% PumpCoins&f adicionados à sua conta.")
    set {autopix::delivery::%{_orderId}%::%{_itemIndex}%::state} to "APPLIED"
    return true
on "io.github.warleysr.autopix.events.PaymentApprovedEvent":
    set {_p} to event.getPlayer()
    set {_nome} to event.getPlayerName()
    set {_produto} to event.getProduct()
    set {_preco} to event.getPrice()
    set {_orderId} to event.getOrderId()
    broadcast ""
    broadcast "&6&l[LOJA] &fO jogador &b&l%{_nome}% &fadquiriu &e&l%{_produto}% &fna loja!"
    broadcast "&7Agradecemos pelo apoio ao servidor! Use &b/loja &7para contribuir."
    broadcast ""
    if {_p} is set:
        if {_p}.isOnline() is true:
            play sound "ui.toast.challenge_complete" with volume 1 and pitch 1 to {_p}
            send title "&a&lPAGAMENTO APROVADO!" with subtitle "&fObrigado pelo seu apoio, &e%{_nome}%&f!" to {_p} for 4 seconds
on "io.github.warleysr.autopix.events.DeliveryStartedEvent":
    set {_handler} to event.getHandler()
    set {_deliveryType} to event.getDeliveryType()
    set {_p} to event.getPlayer()
    set {_orderId} to event.getOrderId()
    set {_itemIndex} to event.getItemIndex()
    set {_claimToken} to event.getClaimToken()
    set {_orderItem} to event.getOrderItem()
    set {_productId} to "desconhecido"
    if {_orderItem} is set:
        set {_productId} to {_orderItem}.getProductId()
    if {_deliveryType} is "skript" or "hybrid":
        if {_claimToken} is not set:
            stop
        if {_claimToken} is "":
            stop
        if {_p} is not set:
            AutoPixAPI.failCustomDelivery({_orderId}, "%{_itemIndex}%", {_claimToken}, "Jogador offline durante entrega Skript.", true)
            stop
        if {_p}.isOnline() is not true:
            AutoPixAPI.failCustomDelivery({_orderId}, "%{_itemIndex}%", {_claimToken}, "Jogador offline durante entrega Skript.", true)
            stop
        set {_ok} to executarEntregaCustomLoja({_p}, {_handler}, "%{_orderId}%", {_itemIndex}, {_claimToken}, {_orderItem})
        if {_ok} is true:
            AutoPixAPI.confirmCustomDelivery({_orderId}, "%{_itemIndex}%", {_claimToken})
        else:
            AutoPixAPI.failCustomDelivery({_orderId}, "%{_itemIndex}%", {_claimToken}, "Handler Skript inválido, incompleto ou em estado de revisão: %{_handler}% / %{_productId}%", false)
on "io.github.warleysr.autopix.events.DeliveryCompletedEvent":
    set {_p} to event.getPlayer()
    if {_p} is set:
        if {_p}.isOnline() is true:
            lojaSucesso({_p}, "Todos os benefícios do pedido #%event.getOrderId()% foram entregues com sucesso!")
on "io.github.warleysr.autopix.events.DeliveryFailedEvent":
    set {_orderId} to event.getOrderId()
    set {_reason} to event.getReason()
    loop all players:
        if loop-player has permission "autopix.admin":
            send "&c&l[ALERTA AUTOPIX] &fFalha na entrega do pedido &e#%{_orderId}%&f: %{_reason}%" to loop-player
on "io.github.warleysr.autopix.events.DeliveryNeedsReviewEvent":
    set {_orderId} to event.getOrderId()
    set {_reason} to event.getReason()
    loop all players:
        if loop-player has permission "autopix.admin":
            send "" to loop-player
            send "&c&l[ALERTA AUTOPIX] &fA entrega do pedido &e#%{_orderId}% &fexige revisão manual!" to loop-player
            send "&7Motivo: &f%{_reason}%" to loop-player
            send "&7Use &b/pix historico &7para inspecionar." to loop-player
            send "" to loop-player
